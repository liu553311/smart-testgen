# LLM API Keys (get at least one)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Default provider: anthropic or openai
SMARTTESTGEN_PROVIDER=openai

# Default model (optional, uses provider default if not set)
# SMARTTESTGEN_MODEL=gpt-4o
# SMARTTESTGEN_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Generation defaults (optional)
# SMARTTESTGEN_NUM_CASES=10
# SMARTTESTGEN_FORMAT=markdown
